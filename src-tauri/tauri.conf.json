{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PL Composer",
  "version": "0.1.0",
  "identifier": "com.psychedluxuries.composer",
  "build": {
    "frontendDist": "http://127.0.0.1:3000",
    "devUrl": "http://127.0.0.1:3000"
  },
  "app": {
    "windows": [
      {
        "title": "PL Composer",
        "width": 1600,
        "height": 960,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0e0c09"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}